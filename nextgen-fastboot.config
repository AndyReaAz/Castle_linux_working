# NextGen fast-boot kernel profile — stage 1
#
# This first baseline deliberately changes compression only.
# DTS contents and driver/probe topology remain unchanged so that the
# boot-time delta measures the effect of LZ4 independently.
#
CONFIG_KERNEL_LZ4=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_BZIP2 is not set
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_ZSTD is not set
# CONFIG_KERNEL_UNCOMPRESSED is not set
